# CRVID — chaves de API (cada pessoa usa as SUAS).
# Copie este arquivo para ".env" (na mesma pasta) e preencha só o que for usar.
# A transcrição NÃO precisa de chave: roda no seu computador.
# Nunca compartilhe o seu .env com ninguém.

# Imagens por IA na tela dividida (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fotos de banco de imagens (Pexels, grátis) — https://www.pexels.com/api/
PEXELS_API_KEY=

# Trilha sonora por IA (Treblo) — opcional
TREBLO_API_KEY=

# Imagens de marcas/pessoas (Google Custom Search) — opcional; o Wikimedia já cobre a maioria sem chave
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
